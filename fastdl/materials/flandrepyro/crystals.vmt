"VertexlitGeneric"
{
	"$basetexture" "flandrepyro/crystals"

	"$phong" "1"
	"$phongboost"	"1"
	"$phongalbedotint" "1"
	"$phongexponenttexture" "flandrepyro/phong_exp"
	"$phongfresnelranges"	"[.2 .2 5]"

	"$lightwarptexture" "flandrepyro/cartoon_shader"

	"$halflambert" "1"	
	"$AmbientOcclusion" "0"	
	"$nocull" "1"
	"$nodecal" "1"
	// "$model" "1"
	// "$selfillum" "1"
	"$additive" "1"
	
	"$emissiveBlendEnabled" 1
	"$emissiveBlendTexture"     "flandrepyro/null"
	"$emissiveBlendBaseTexture"	"flandrepyro/crystals"
	"$emissiveBlendFlowTexture"  "flandrepyro/null"
	"$emissiveBlendTint" "[1.0 1.0 1.0]"
	"$emissiveBlendStrength" 0.75
	"$emissiveBlendScrollVector" "[0 0]"

	"$detail" "effects/tiledfire/fireLayeredSlowTiled512.vtf"	
	"$detailscale" "5"
	"$detailblendfactor" .01
	"$detailblendmode" 6


	"$yellow" "0"
	"$one" "1"
	"$cloakPassEnabled" "1"
	"Proxies"
	{
		"spy_invis" //wmodel and team color cloak support
		{
		}
		"invis" //vmodel cloak support
		{
		}
		"AnimatedTexture"
		{
			"animatedtexturevar" "$detail"
			"animatedtextureframenumvar" "$detailframe"
			"animatedtextureframerate" 30
		}
		"BurnLevel"
		{
			"resultVar" "$detailblendfactor"
		}
		"YellowLevel"
		{
			"resultVar" "$yellow"
		}
		"Equals"
		{
			"srcVar1" "$yellow"
			"resultVar" "$color2"
		}
		"Equals"
		{
			"srcVar1"  "$yellow"
			"resultVar" "$selfillumtint"
		}

	}
}