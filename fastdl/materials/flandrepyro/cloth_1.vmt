"VertexlitGeneric"
{
	"$basetexture" "flandrepyro/cloth_1"

	"$phong" "1"
	"$phongboost"	"1"
	"$phongalbedotint" "1"
	"$phongexponenttexture" "flandrepyro/phong_exp"
	"$phongfresnelranges"	"[.2 .2 5]"

	"$lightwarptexture" "flandrepyro/face_shader"

	"$halflambert" "1"	
	"$nocull" "1"
	"$nodecal" "1"
	
	"$rimlight" "1"
	"$rimlightexponent" "3"
	"$rimlightboost" "4"

	"$detail" "effects/tiledfire/fireLayeredSlowTiled512.vtf"	
	"$detailscale" "5"
	"$detailblendfactor" .01
	"$detailblendmode" 6


	"$yellow" "0"
	"$one" "1"
	"$cloakPassEnabled" "1"
	"Proxies"
	{
		"spy_invis" //wmodel and team color cloak support
		{
		}
		"invis" //vmodel cloak support
		{
		}
		"AnimatedTexture"
		{
			"animatedtexturevar" "$detail"
			"animatedtextureframenumvar" "$detailframe"
			"animatedtextureframerate" 30
		}
		"BurnLevel"
		{
			"resultVar" "$detailblendfactor"
		}
		"YellowLevel"
		{
			"resultVar" "$yellow"
		}
		"Equals"
		{
			"srcVar1" "$yellow"
			"resultVar" "$color2"
		}
		"Equals"
		{
			"srcVar1"  "$yellow"
			"resultVar" "$selfillumtint"
		}

	}
}