"VertexlitGeneric"
{
	"$basetexture" "remiliaspy/red2"

	"$phong" "1"
	"$phongboost"	"2"
	"$phongalbedotint" "1"
	"$phongexponenttexture" "remiliaspy/phong_exp"
	"$phongfresnelranges"	"[.1 .1 5]"

	"$lightwarptexture" "remiliaspy/cartoon_shader"

	"$halflambert" "1"	
	"$nodecal" "1"
	
	"$rimlight" "1"
	"$rimlightexponent" "3"
	"$rimlightboost" "4"
	"$detail" "effects/tiledfire/fireLayeredSlowTiled512.vtf"	
	"$detailscale" "5"
	"$detailblendfactor" .01
	"$detailblendmode" 6


	"$yellow" "0"
	"$one" "1"
	"$cloakPassEnabled" "1"
	"Proxies"
	{
		"spy_invis" //wmodel and team color cloak support
		{
		}
		"invis" //vmodel cloak support
		{
		}
		"AnimatedTexture"
		{
			"animatedtexturevar" "$detail"
			"animatedtextureframenumvar" "$detailframe"
			"animatedtextureframerate" 30
		}
		"BurnLevel"
		{
			"resultVar" "$detailblendfactor"
		}
		"YellowLevel"
		{
			"resultVar" "$yellow"
		}
		"Equals"
		{
			"srcVar1" "$yellow"
			"resultVar" "$color2"
		}
	}
}

