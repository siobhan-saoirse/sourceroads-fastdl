"VertexlitGeneric"
{
	"$basetexture" "sakuyaspy\head"
	"$bumpmap" "sakuyaspy\normal"
	"$ambientocclusion" "0"
	"$model" "1"
	"$nodecal" "1"
	"$nocull" "1"
	"$allowalphatocoverage" 1
	"$normalmapalphaphongmask"	"1"
	"$halflambert" "1"
	
	"$BlendTintByBaseAlpha"     "1"
	"$Color2"	"{ 255 255 255 }"

	"$lightwarptexture" "sakuyaspy\lightwarp"

                "$phong" "1"
                "$phongboost" "0.7"
                "$phongexponent" "5"
	"$phongexponenttexture" "sakuyaspy\phong"
	"$phongalbedotint"          "0"
	"$phongdisablehalflambert"  "1"
                "$phongfresnelranges"	"[0 0.5 1]"

	"$rimlight"               "1"
	"$rimlightexponent"       "1"
	"$rimlightboost"          "1"

	"$detail" "effects/tiledfire/fireLayeredSlowTiled512.vtf"	
	"$detailscale" "5"
	"$detailblendfactor" .01
	"$detailblendmode" 6


	"$yellow" "0"
	"$one" "1"
	"$cloakPassEnabled" "1"
	"Proxies"
	{
		"spy_invis" //wmodel and team color cloak support
		{
		}
		"invis" //vmodel cloak support
		{
		}
		"AnimatedTexture"
		{
			"animatedtexturevar" "$detail"
			"animatedtextureframenumvar" "$detailframe"
			"animatedtextureframerate" 30
		}
		"BurnLevel"
		{
			"resultVar" "$detailblendfactor"
		}
		"YellowLevel"
		{
			"resultVar" "$yellow"
		}
		"Equals"
		{
			"srcVar1" "$yellow"
			"resultVar" "$color2"
		}
		"Equals"
		{
			"srcVar1"  "$yellow"
			"resultVar" "$selfillumtint"
		}

	}
}